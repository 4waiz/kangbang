{
  "name": "kang-bang",
  "version": "1.0.0",
  "private": true,
  "description": "KANG BANG - an original browser-based competitive sci-fi FPS",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @kang/server",
    "dev:client": "npm run dev -w @kang/client",
    "build": "npm run build -w @kang/server && npm run build -w @kang/client",
    "build:server": "npm run build -w @kang/server",
    "build:client": "npm run build -w @kang/client",
    "start": "node packages/server/dist/index.mjs",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/server --noEmit && tsc -p packages/client --noEmit",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "lint:fix": "eslint \"packages/*/src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "assets": "node tools/build-assets.mjs",
    "assets:check": "node tools/build-assets.mjs --check",
    "bots": "node tools/bot-match.mjs",
    "clients": "node tools/open-clients.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
