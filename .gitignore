node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.env
.env.local
.env.*.local
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vite/
.idea/
.vscode/*
!.vscode/extensions.json

# Runtime data / dev database
data/*.db
data/*.db-journal
data/*.sqlite
packages/server/data/
# SQLite WAL-mode sidecar files (written next to the database at runtime)
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Blender scratch output
assets/source/*.blend1
assets/.cache/
tools/.blender-path

# Python bytecode. Blender imports the generator scripts, so it writes these
# next to the sources on every asset build.
__pycache__/
*.pyc
