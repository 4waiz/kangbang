# ---------------------------------------------------------------------------
# KANG BANG - environment configuration example
#
# Copy to `.env` for local dev:  cp .env.example .env
# `.env` is gitignored. NEVER commit a real .env, and never put a real secret
# in this file - it is a template that ships in the repository.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# HTTP + WebSocket port for the authoritative game server.
PORT=2567
# Bind host. 0.0.0.0 inside containers, 127.0.0.1 for local-only dev.
HOST=0.0.0.0
# development | production. `production` enables strict secret checks.
NODE_ENV=development

# Simulation tick rate (Hz). 60 is the shipping value; lower to save CPU.
TICK_RATE=60
# Snapshot broadcast rate (Hz). Clients interpolate between snapshots.
SNAPSHOT_RATE=20
# Maximum concurrent rooms this process will host.
MAX_ROOMS=64
# Maximum players per room (bots included).
MAX_PLAYERS_PER_ROOM=16

# Comma separated list of allowed browser origins (CORS + WS origin check).
# Use * only for local development - in production list your real origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Secret used to sign guest/session tokens.
# GENERATE YOUR OWN before deploying - the server refuses to start in
# production without one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-insecure-secret-change-me

# --- Persistence ----------------------------------------------------------
# sqlite (default, zero-config local dev) | postgres | memory
DB_DRIVER=sqlite
# SQLite file location (relative paths resolve from the repository root).
SQLITE_PATH=./data/kangbang.db
# Postgres connection string, used when DB_DRIVER=postgres.
# DATABASE_URL=postgres://kang:kang@localhost:5432/kangbang

# --- Anti-cheat / rate limiting -------------------------------------------
# Extra slack on the server-side speed check, on top of the built-in float
# tolerance. 1.0 = no extra slack. Raise only if legitimate players are flagged.
MOVE_TOLERANCE=1.05
# Max client messages per second before a connection is throttled.
MSG_RATE_LIMIT=180
# Log suspicious events to stdout as structured JSON.
LOG_SUSPICIOUS=true

# --- Bots -----------------------------------------------------------------
# Automatically top up matches with bots so games are always playable.
BOT_FILL=true
# Fill each match up to this many participants.
BOT_FILL_TARGET=8
# easy | normal | hard
BOT_DIFFICULTY=normal

# --- Client (Vite, must be prefixed with VITE_) ---------------------------
# Leave blank to auto-derive from window.location, which is what you want for
# Docker and for any deployment where the client is served from the same host.
VITE_SERVER_URL=
# Shown on the main menu, useful for telling builds apart.
VITE_BUILD_LABEL=local-dev
